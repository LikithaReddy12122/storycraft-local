# ===================================================
# StoryCraft Local - AI Tourism Environment Variables
# ===================================================

# Google Gemini API Key
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Preferred Gemini Model (gemini-1.5-flash, gemini-2.0-flash, or gemini-1.5-pro)
GEMINI_MODEL=gemini-1.5-flash

# Server Port (default: 3000)
PORT=3000
